{
  "name": "mpesa",
  "sourceRoot": "packages/mpesa/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "rootDir": "packages/mpesa/src",
        "outputPath": "packages/mpesa/dist",
        "main": "packages/mpesa/src/index.ts",
        "tsConfig": "packages/mpesa/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/vite:test"
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["ts-node packages/mpesa/dev-server/index.ts"]
      }
    },
    "publish-package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/mpesa",
        "commands": ["yarn npm publish"]
      }
    }
  }
}
